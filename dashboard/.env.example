# Copy this file to .env.local and fill in your Supabase project values.
# Next.js only exposes env vars prefixed with NEXT_PUBLIC_ to browser code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the redirectTo URL for password reset emails
# (forgotPasswordAction in lib/auth-actions.ts) — must match this
# dashboard's real deployed origin so the emailed link actually comes back
# here. Defaults to http://localhost:3000 in code if unset, matching the
# DASHBOARD_URL pattern already used by supabase/functions/send-alert-email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (no NEXT_PUBLIC_ prefix). Must equal the DASHBOARD_FORWARD_SECRET
# secret on the auth-identifier edge function. Lets the function rate-limit
# phone sign-ins by the end user's IP instead of this server's. Leave empty
# to skip IP forwarding; per-phone limits still apply.
DASHBOARD_FORWARD_SECRET=
