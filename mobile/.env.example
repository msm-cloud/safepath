# Copy this file to .env and fill in your Supabase project values.
# Expo only exposes env vars prefixed with EXPO_PUBLIC_ to app code.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Path to the Firebase Android config (google-services.json), read by
# app.config.js for `expo prebuild` / local Android builds. Get the file
# from the Firebase console; it is gitignored and must never be committed.
# EAS Build supplies this automatically via the GOOGLE_SERVICES_JSON secret.
GOOGLE_SERVICES_JSON=./google-services.json

# Region the auth-identifier edge function runs in. Set it to the database's
# region so the function's database round trips stay in-region. Must be a
# supabase-js FunctionRegion value; EAS builds take it from eas.json.
EXPO_PUBLIC_SUPABASE_FUNCTION_REGION=ap-southeast-1

# Support address shown when an account is missing its profile and can't be
# fixed from the app. Leave empty to show the message without an address.
# EAS builds and updates need it set as an EAS environment variable too.
EXPO_PUBLIC_SUPPORT_EMAIL=
